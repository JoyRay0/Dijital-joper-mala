<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        style="@style/check_box"
        android:layout_marginStart="10dp"
        android:visibility="visible"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_delete"
        android:padding="5dp"
        android:layout_margin="5dp"
        android:background="?attr/actionBarItemBackground"
        android:layout_alignParentEnd="true"
        android:visibility="visible"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_jopa_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_view_color"
        app:cardCornerRadius="15dp"
        app:cardElevation="2dp"
        android:layout_margin="10dp"
        android:layout_below="@id/iv_delete"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textSize="17sp"
                android:textColor="@color/normal_text_color"
                android:fontFamily="@font/noto_serif_bengali"
                android:layout_margin="5dp"
                android:gravity="start"
                />

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardElevation="2dp"
                app:cardCornerRadius="13dp"
                app:cardBackgroundColor="@color/history_count"
                android:layout_margin="5dp"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="108"
                    android:textSize="20sp"
                    android:textColor="@color/normal_text_color"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:padding="5dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />

            </androidx.cardview.widget.CardView>



        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>