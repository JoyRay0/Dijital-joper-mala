<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.Fg_show_user_mala"
    android:background="@color/background_color"
    >

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <FrameLayout
                android:id="@+id/fl_add_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/lay_add_img"/>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!-- mantra1 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_mantra1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:text="প্রথম মন্ত্র:"
                    android:textColor="@color/normal_text_color"
                    android:textSize="17sp"
                    android:textStyle="normal"
                    android:visibility="gone"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_save_mantras1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:gravity="center"
                    android:text="প্রথম জপ মন্ত্র"
                    android:textColor="@color/bold_text_color"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    />

                <!-- mantra2 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_mantra2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:text="দ্বিতীয় মন্ত্র:"
                    android:textColor="@color/normal_text_color"
                    android:textSize="17sp"
                    android:textStyle="normal"
                    android:visibility="gone"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_save_mantras2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:gravity="center"
                    android:text="দ্বিতীয় জপ মন্ত্র"
                    android:textColor="@color/bold_text_color"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    />

                <!-- mantra3 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_mantra3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:text="তৃতীয় মন্ত্র:"
                    android:textColor="@color/normal_text_color"
                    android:textSize="17sp"
                    android:textStyle="normal"
                    android:visibility="gone"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_save_mantras3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:gravity="center"
                    android:text="তৃতীয় জপ মন্ত্র"
                    android:textColor="@color/bold_text_color"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    />

                <!-- mantra4 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_mantra4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:text="চতুর্থ মন্ত্র:"
                    android:textColor="@color/normal_text_color"
                    android:textSize="17sp"
                    android:textStyle="normal"
                    android:visibility="gone"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_save_mantras4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:gravity="center"
                    android:text="চতুর্থ জপ মন্ত্র"
                    android:textColor="@color/bold_text_color"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    />


            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <include layout="@layout/lay_jopa"/>

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</RelativeLayout>