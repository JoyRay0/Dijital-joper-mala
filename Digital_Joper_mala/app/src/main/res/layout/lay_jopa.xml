<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"

    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="#00FFFFFF"
        android:orientation="horizontal"
        android:padding="10dp"
        android:baselineAligned="false"
        android:weightSum="3">


        <!-- 1st steep -->
        <RelativeLayout
            android:id="@+id/liner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/sh_jopa_background"
            android:elevation="5dp"

            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cd_save_count1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/jopa_count"
                app:cardElevation="2dp"
                app:cardCornerRadius="10dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="15dp"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="জপ সংখ্যা"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="@color/normal_text_color"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:padding="10dp"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawablePadding="7dp"
                    />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/first_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/stage1"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:textStyle="bold"

                />

            <TextView
                android:id="@+id/jopa_info1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/bar108"
                android:textColor="@color/normal_text_color"
                android:textSize="18sp"
                android:layout_below="@id/first_step"
                />

            <TextView
                android:id="@+id/tv_count_display1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:background="@drawable/sh_counter_display"
                android:elevation="5dp"
                android:gravity="center|bottom"
                android:text="০"
                android:textColor="@color/bold_text_color"
                android:textSize="30sp"
                android:layout_below="@id/jopa_info1"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sh_button_style"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/addone"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:layout_below="@id/tv_count_display1"
                />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reset1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sh_button_style"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/reset"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:layout_below="@id/add1"
                />

        </RelativeLayout>


        <!-- 2nd steep -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/sh_jopa_background"
            android:elevation="5dp"
            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cd_save_count2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/jopa_count"
                app:cardElevation="2dp"
                app:cardCornerRadius="10dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="15dp"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="জপ সংখ্যা"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="@color/normal_text_color"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:padding="10dp"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawablePadding="7dp"
                    />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/second_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/stage2"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jopa_info2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/bar16"
                android:textColor="@color/normal_text_color"
                android:textSize="18sp"
                android:layout_below="@id/second_step"
                />

            <TextView
                android:id="@+id/tv_count_display2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_margin="15dp"
                android:background="@drawable/sh_counter_display"
                android:elevation="5dp"
                android:gravity="center|bottom"
                android:text="০"
                android:fontFamily="@font/noto_serif_bengali"
                android:textColor="@color/bold_text_color"
                android:textSize="30sp"
                android:layout_below="@id/jopa_info2"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sh_button_style"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/addone"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:layout_below="@id/tv_count_display2"
                />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reset2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sh_button_style"
                android:elevation="10dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/reset"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:layout_below="@id/add2"
                />

        </RelativeLayout>


        <!-- 3rd steep -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/sh_jopa_background"
            android:elevation="5dp"

            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cd_save_count3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/jopa_count"
                app:cardElevation="2dp"
                app:cardCornerRadius="10dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="15dp"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="জপ সংখ্যা"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="@color/normal_text_color"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:padding="10dp"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawablePadding="7dp"
                    />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/third_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/stage3"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jopa_info3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/bar4"
                android:textColor="@color/normal_text_color"
                android:textSize="18sp"
                android:layout_below="@id/third_step"
                />

            <TextView
                android:id="@+id/tv_count_display3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/noto_serif_bengali"
                android:layout_margin="15dp"
                android:background="@drawable/sh_counter_display"
                android:elevation="5dp"
                android:gravity="center|bottom"
                android:text="০"
                android:textColor="@color/bold_text_color"
                android:textSize="30sp"
                android:layout_below="@id/jopa_info3"
                />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sh_button_style"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/addone"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:layout_below="@id/tv_count_display3"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reset3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sh_button_style"
                android:fontFamily="@font/noto_serif_bengali"
                android:text="@string/reset"
                android:textColor="@color/bold_text_color"
                android:textSize="18sp"
                android:layout_below="@id/add3"
                />

        </RelativeLayout>

    </LinearLayout>


</HorizontalScrollView>