<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="15dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_view_color"
    android:layout_margin="10dp"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <!-- mala title -->
        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/ed_mala_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="মালার নাম"
            android:textColorHint="@color/hint_color"
            android:textSize="17sp"
            android:inputType="text"
            android:gravity="center"
            android:fontFamily="@font/noto_serif_bengali"
            android:textColor="@color/normal_text_color"
            android:background="@drawable/sh_create_mala_edit_text"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:textCursorDrawable="@null"
            android:cursorVisible="true"
            android:imeOptions="actionNext"
            />

        <!-- mala image -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ছবি আপলোড"
            android:textSize="17sp"
            android:textColor="@color/hint_color"
            android:fontFamily="@font/noto_serif_bengali"
            android:background="@drawable/sh_create_mala_edit_text"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:drawableEnd="@drawable/ic_upload"
            />

        <!-- matra 1 -->
        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/ed_mala1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="১ম মন্ত্র"
            android:textColorHint="@color/hint_color"
            android:textSize="17sp"
            android:fontFamily="@font/noto_serif_bengali"
            android:textColor="@color/normal_text_color"
            android:background="@drawable/sh_create_mala_edit_text"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:textCursorDrawable="@null"
            android:cursorVisible="true"
            />

        <!-- matra 2 -->
        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/ed_mala2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="২য় মন্ত্র"
            android:textColorHint="@color/hint_color"
            android:textSize="17sp"
            android:fontFamily="@font/noto_serif_bengali"
            android:textColor="@color/normal_text_color"
            android:background="@drawable/sh_create_mala_edit_text"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:textCursorDrawable="@null"
            android:cursorVisible="true"
            />

        <!-- matra 3 -->
        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/ed_mala3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="৩য় মন্ত্র"
            android:textColorHint="@color/hint_color"
            android:textSize="17sp"
            android:fontFamily="@font/noto_serif_bengali"
            android:textColor="@color/normal_text_color"
            android:background="@drawable/sh_create_mala_edit_text"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:textCursorDrawable="@null"
            android:cursorVisible="true"
            />

        <!-- matra 4 -->
        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/ed_mala4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="৪র্থ মন্ত্র"
            android:textColorHint="@color/hint_color"
            android:textSize="17sp"
            android:fontFamily="@font/noto_serif_bengali"
            android:textColor="@color/normal_text_color"
            android:background="@drawable/sh_create_mala_edit_text"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:textCursorDrawable="@null"
            android:cursorVisible="true"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_margin="15dp"
            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cd_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F6E7E7"
                app:cardElevation="2dp"
                app:cardCornerRadius="15dp"
                android:layout_margin="10dp"
                android:layout_weight="1"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="বন্ধ"
                    android:textSize="15sp"
                    android:textColor="#000"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:padding="10dp"
                    android:gravity="center"
                    />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cd_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#5FB262"
                app:cardElevation="2dp"
                app:cardCornerRadius="15dp"
                android:layout_margin="10dp"
                android:layout_weight="1"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="সেভ"
                    android:textSize="15sp"
                    android:textColor="#fff"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:padding="10dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>