<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="15dp"
    android:layout_margin="15dp"
    app:cardBackgroundColor="@color/card_view_color"
    android:id="@+id/cv_dialog"
    android:visibility="visible"
    >

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_no_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="কোন নোটিফিকেশন নেই।"
                android:fontFamily="@font/noto_serif_bengali"
                android:textSize="17sp"
                android:textColor="@color/normal_text_color"
                android:textStyle="normal"
                android:gravity="center"
                android:layout_margin="10dp"
                android:visibility="visible"
                />

            <LinearLayout
                android:id="@+id/ll_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:visibility="gone"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/img_gallery"
                    android:layout_gravity="center"
                    android:contentDescription="image"
                    android:scaleType="fitXY"
                    />

            </LinearLayout>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textSize="17sp"
                android:fontFamily="@font/noto_serif_bengali"
                android:textColor="@color/bold_text_color"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_notification_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:fontFamily="@font/noto_serif_bengali"
                android:textSize="15sp"
                android:textColor="@color/normal_text_color"
                android:textStyle="normal"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:visibility="gone"
                />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mb_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="বন্ধ"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/bold_text_color"
                    android:layout_margin="15dp"
                    android:background="?attr/selectableItemBackground"
                    android:layout_alignParentStart="true"
                    android:visibility="gone"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mb_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="লিংক"
                    android:fontFamily="@font/noto_serif_bengali"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/bold_text_color"
                    android:layout_margin="15dp"
                    android:background="?attr/selectableItemBackground"
                    android:layout_alignParentEnd="true"
                    android:visibility="gone"
                    />

            </RelativeLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.cardview.widget.CardView>